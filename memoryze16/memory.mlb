# Memoryze16 memory macros for CoCAS 0.2.3.
# mem[X] denotes one 16-bit word at byte address X.
# Every macro preserves SP. PS is scratch state after expansion.
# Every unlisted register and memory cell is preserved.
# Word addresses, SP and stack byte displacements must be even.

# incmem ADDRESS
# Increment one memory word.
# @param ADDRESS Immediate byte address or label, even for word access
# @return mem[ADDRESS] = (mem[ADDRESS] + 1) modulo 65536
# @changed r0, r1, PS, mem[ADDRESS]
# Preserves SP and every unlisted register and memory cell.
*incmem/1
    ldi r0, $1
    ldw r0, r1
    inc r1
    stw r0, r1

# decmem ADDRESS
# Decrement one memory word.
# @param ADDRESS Immediate byte address or label, even for word access
# @return mem[ADDRESS] = (mem[ADDRESS] - 1) modulo 65536
# @changed r0, r1, PS, mem[ADDRESS]
# Preserves SP and every unlisted register and memory cell.
*decmem/1
    ldi r0, $1
    ldw r0, r1
    dec r1
    stw r0, r1

# setmem ADDRESS, VALUE
# Store an immediate word in memory.
# @param ADDRESS Immediate byte address or label, even for word access
# @param VALUE Immediate 16-bit value
# @return mem[ADDRESS] = VALUE modulo 65536
# @changed r0, r1, PS, mem[ADDRESS]
# Preserves SP and every unlisted register and memory cell.
*setmem/2
    ldi r0, $1
    ldi r1, $2
    stw r0, r1

# getmem REG, ADDRESS
# Load one memory word into a register.
# @param REG Register r0 through r7
# @param ADDRESS Immediate byte address or label, even for word access
# @return REG = mem[ADDRESS]
# @changed REG, PS
# Preserves SP and every unlisted register and memory cell.
*getmem/2
    ldi $1, $2
    ldw $1, $1

# putmem ADDRESS, REG, TMP
# Store a register word in memory.
# @param ADDRESS Immediate byte address or label, even for word access
# @param REG Register r0 through r7
# @param TMP Scratch register, distinct from every live source or address register
# @return mem[ADDRESS] = REG
# @changed TMP, PS, mem[ADDRESS]
# Preserves SP and every unlisted register and memory cell.
# TMP must differ from REG.
*putmem/3
    ldi $3, $1
    stw $3, $2

# copymem SRC, DST
# Copy one memory word.
# @param SRC Immediate byte address or label, even for word access
# @param DST Immediate byte address or label, even for word access
# @return mem[DST] = original mem[SRC]
# @changed r0, r1, r2, PS, mem[DST]
# Preserves SP and every unlisted register and memory cell.
# SRC and DST may be the same address.
*copymem/2
    ldi r0, $1
    ldw r0, r1
    ldi r2, $2
    stw r2, r1

# swapmem A, B
# Exchange two memory words.
# @param A Immediate byte address or label, even for word access
# @param B Immediate byte address or label, even for word access
# @return mem[A] = original mem[B] and mem[B] = original mem[A]
# @changed r0, r1, r2, r3, PS, mem[A], mem[B]
# Preserves SP and every unlisted register and memory cell.
# A and B may be the same address.
*swapmem/2
    ldi r0, $1
    ldi r2, $2
    ldw r0, r1
    ldw r2, r3
    stw r0, r3
    stw r2, r1

# summem SRC, DST
# Add one memory word to another.
# @param SRC Immediate byte address or label, even for word access
# @param DST Immediate byte address or label, even for word access
# @return mem[DST] = (original mem[DST] + original mem[SRC]) modulo 65536
# @changed r0, r1, r2, r3, PS, mem[DST]
# Preserves SP and every unlisted register and memory cell.
# Equal source and destination addresses double the original value.
*summem/2
    ldi r0, $1
    ldw r0, r1
    ldi r2, $2
    ldw r2, r3
    add r1, r3
    stw r2, r3

# submem SRC, DST
# Subtract the source memory word from the destination.
# @param SRC Immediate byte address or label, even for word access
# @param DST Immediate byte address or label, even for word access
# @return mem[DST] = (original mem[DST] - original mem[SRC]) modulo 65536
# @changed r0, r1, r2, r3, PS, mem[DST]
# Preserves SP and every unlisted register and memory cell.
# Equal source and destination addresses produce zero.
*submem/2
    ldi r0, $1
    ldw r0, r1
    ldi r2, $2
    ldw r2, r3
    sub r3, r1
    stw r2, r1

# mulmem SRC, DST
# Multiply two memory words.
# @param SRC Immediate byte address or label, even for word access
# @param DST Immediate byte address or label, even for word access
# @return mem[DST] = (original mem[DST] * original mem[SRC]) modulo 65536
# @changed r0, r1, r2, r3, PS, mem[DST]
# Preserves SP and every unlisted register and memory cell.
# Equal source and destination addresses square the original value. Uses at most 16 shift-and-add iterations.
*mulmem/2
    ldi r0, $1
    ldw r0, r1
    ldi r0, $2
    ldw r0, r2
    clr r3
    while
        tst r2
    stays nz
        if
            shr r2
        is cs
            add r1, r3
        fi
        shl r1
    wend
    stw r0, r3
